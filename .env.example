# ==============================================================================
# Auth_forge Environment Configuration Template
# ==============================================================================
# Duplicate this file as '.env' and update values according to your environment.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_service
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Security & Token Configuration
# ------------------------------------------------------------------------------
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
